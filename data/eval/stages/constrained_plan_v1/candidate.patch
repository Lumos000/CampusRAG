+import json
+
+import pytest
+
+from campus_rag.rag.planner import plan_schema, parse_plan
+
+
+def accepted(schema, value):
+    from lmformatenforcer import JsonSchemaParser
+    parser=JsonSchemaParser(schema)
+    # The bare parser uses an ASCII alphabet. The real token enforcer replaces
+    # it with the tokenizer alphabet; JSON escapes keep this isolated test valid.
+    for ch in json.dumps(value,ensure_ascii=True):
+        if ch not in parser.get_allowed_characters():
+            return False
+        parser=parser.add_character(ch)
+    return parser.can_end()
+
+
+def test_complete_constant_plan_and_incomplete_plan_are_distinct():
+    schema=plan_schema({'facts':[{'fact_id':'f7'}]},'multiply')
+    steps=[{'id':'rate','op':'lookup','fact_id':'f7'},
+        {'id':'quantity','op':'lookup','literal':'7','unit':'小时'},
+        {'id':'total','op':'multiply','inputs':['rate','quantity']}]
+    assert accepted(schema,{'table_id':None,'steps':steps})
+    assert not accepted(schema,{'table_id':None,'steps':[steps[0],steps[2]]})
+
+
+@pytest.mark.parametrize('mutation',['table','field','fact','arity'])
+def test_schema_rejects_unknown_bindings_and_missing_operands(mutation):
+    payload={'tables':[{'table_id':71,'columns':[{'field_id':83}]}],
+        'facts':[{'fact_id':'f7'}]}
+    schema=plan_schema(payload)
+    plan={'table_id':71,'steps':[{'id':'a','op':'sum','field_id':83}]}
+    if mutation=='table':plan['table_id']=999
+    if mutation=='field':plan['steps'][0]['field_id']=999
+    if mutation=='fact':plan['steps']=[{'id':'a','op':'lookup','fact_id':'invented'}]
+    if mutation=='arity':plan['steps']=[{'id':'a','op':'divide','inputs':['missing']}]
+    assert not accepted(schema,plan)
+
+
+def test_format_validity_does_not_validate_reference_semantics():
+    plan={'table_id':None,'steps':[{'id':'a','op':'lookup','fact_id':'f7'},
+        {'id':'b','op':'lookup','literal':'2','unit':'小时'},
+        {'id':'c','op':'multiply','inputs':['a','missing']}]}
+    assert accepted(plan_schema({'facts':[{'fact_id':'f7'}]},'multiply'),plan)
+    with pytest.raises(ValueError,match='未先定义'):
+        parse_plan(json.dumps(plan),require_final=True)
